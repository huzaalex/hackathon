# Copiați în .env și completați cheia.
BEDROCK_API_KEY=
AWS_REGION=us-east-1
# Modelul principal (Claude Opus 5.5 pe Amazon Bedrock)
LLM_MODEL=anthropic.claude-opus-5-5
# Model folosit doar dacă modelul principal refuză o cerere (stop_reason = refusal). Gol = dezactivat.
LLM_FALLBACK_MODEL=anthropic.claude-opus-4-8
# low | medium | high  (medium = echilibru viteză/calitate pentru demo)
LLM_EFFORT=medium
# Efortul pentru sub-agenții simpli (citire, identificare, acțiune); low = mai rapid la demo
LLM_SUBAGENT_EFFORT=low
